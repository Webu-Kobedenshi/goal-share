generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Group {
  id        String           @id @default(cuid())
  name      String
  createdAt DateTime         @default(now())
  users     User[]
  proposals GoalProposal[]
}

model User {
  id          String           @id @default(cuid())
  name        String           @unique
  groupId     String
  group       Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  proposals   GoalProposal[]   @relation("Proposer")
  votes       Vote[]
  completions GoalCompletion[]
  createdAt   DateTime         @default(now())
}

model GoalProposal {
  id           String           @id @default(cuid())
  content      String
  durationDays Int
  status       String           @default("pending")
  groupId      String
  group        Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  proposerId   String
  proposer     User             @relation("Proposer", fields: [proposerId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())
  votes        Vote[]
  completions  GoalCompletion[]

  @@index([groupId, status])
  @@index([proposerId, createdAt])
}

model Vote {
  id         String       @id @default(cuid())
  proposalId String
  proposal   GoalProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([proposalId, userId])
}

model GoalCompletion {
  id         String       @id @default(cuid())
  proposalId String
  proposal   GoalProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedAt DateTime   @default(now())

  @@unique([proposalId, userId])
}
